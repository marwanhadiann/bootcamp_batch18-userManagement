<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users</title>
</head>

<body>
    <h1>User Management System</h1>

    <h2>List Users</h2>

    <% users.forEach( user=> { %>
        <ul>
            <li> Name :
                <%= user.name %>
            </li>
            <li> Email :
                <%= user.email %>
            </li>
            <li> No Telp :
                <%= user.telp %>
            </li>
            <li> Role :
                <%= user.role %>
            </li>
            <li> Status :
                <%= user.status %>
            </li>
        </ul>
        <% }) %>

</body>

</html>